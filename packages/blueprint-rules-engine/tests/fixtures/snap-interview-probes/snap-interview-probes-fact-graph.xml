<FactDictionaryModule>
  <Fact path="/household_monthlyIncome">
    <Writable>
      <Int/>
    </Writable>
  </Fact>
  <Fact path="/household_monthlyExpenses">
    <Writable>
      <Int/>
    </Writable>
  </Fact>
  <Fact path="/household_members">
    <Writable>
      <Collection/>
    </Writable>
  </Fact>
  <Fact path="/household_members/*/age">
    <Writable>
      <Int/>
    </Writable>
  </Fact>
  <Fact path="/household_members/*/isEmployed">
    <Writable>
      <Boolean/>
    </Writable>
  </Fact>
  <Fact path="/household_members/*/isStudent">
    <Writable>
      <Boolean/>
    </Writable>
  </Fact>
  <Fact path="/household_members/*/isNonCitizen">
    <Writable>
      <Boolean/>
    </Writable>
  </Fact>
  <Fact path="/household_members/*/isFelon">
    <Writable>
      <Boolean/>
    </Writable>
  </Fact>
  <Fact path="/application_hasChangedCircumstances">
    <Writable>
      <Boolean/>
    </Writable>
  </Fact>
  <Fact path="/incomeGapExists">
    <Derived>
      <LessThan>
        <Left>
          <Dependency path="/household_monthlyIncome"/>
        </Left>
        <Right>
          <Dependency path="/household_monthlyExpenses"/>
        </Right>
      </LessThan>
    </Derived>
  </Fact>
  <Fact path="/hasUnemployedWorkEligible">
    <Derived>
      <GreaterThan>
        <Left>
          <CollectionSize>
            <Filter path="/household_members">
              <All>
                <GreaterThanOrEqual>
                  <Left>
                    <Dependency path="age"/>
                  </Left>
                  <Right>
                    <Int>16</Int>
                  </Right>
                </GreaterThanOrEqual>
                <LessThanOrEqual>
                  <Left>
                    <Dependency path="age"/>
                  </Left>
                  <Right>
                    <Int>59</Int>
                  </Right>
                </LessThanOrEqual>
                <Not>
                  <Dependency path="isEmployed"/>
                </Not>
              </All>
            </Filter>
          </CollectionSize>
        </Left>
        <Right>
          <Int>0</Int>
        </Right>
      </GreaterThan>
    </Derived>
  </Fact>
  <Fact path="/hasUnemployedAbawdCandidate">
    <Derived>
      <GreaterThan>
        <Left>
          <CollectionSize>
            <Filter path="/household_members">
              <All>
                <GreaterThanOrEqual>
                  <Left>
                    <Dependency path="age"/>
                  </Left>
                  <Right>
                    <Int>18</Int>
                  </Right>
                </GreaterThanOrEqual>
                <LessThanOrEqual>
                  <Left>
                    <Dependency path="age"/>
                  </Left>
                  <Right>
                    <Int>54</Int>
                  </Right>
                </LessThanOrEqual>
                <Not>
                  <Dependency path="isEmployed"/>
                </Not>
              </All>
            </Filter>
          </CollectionSize>
        </Left>
        <Right>
          <Int>0</Int>
        </Right>
      </GreaterThan>
    </Derived>
  </Fact>
  <Fact path="/hasStudentMembers">
    <Derived>
      <GreaterThan>
        <Left>
          <CollectionSize>
            <Filter path="/household_members">
              <Dependency path="isStudent"/>
            </Filter>
          </CollectionSize>
        </Left>
        <Right>
          <Int>0</Int>
        </Right>
      </GreaterThan>
    </Derived>
  </Fact>
  <Fact path="/hasNonCitizenMembers">
    <Derived>
      <GreaterThan>
        <Left>
          <CollectionSize>
            <Filter path="/household_members">
              <Dependency path="isNonCitizen"/>
            </Filter>
          </CollectionSize>
        </Left>
        <Right>
          <Int>0</Int>
        </Right>
      </GreaterThan>
    </Derived>
  </Fact>
  <Fact path="/hasFelonMembers">
    <Derived>
      <GreaterThan>
        <Left>
          <CollectionSize>
            <Filter path="/household_members">
              <Dependency path="isFelon"/>
            </Filter>
          </CollectionSize>
        </Left>
        <Right>
          <Int>0</Int>
        </Right>
      </GreaterThan>
    </Derived>
  </Fact>
  <Fact path="/incomeInconsistencyProbe">
    <Derived>
      <Dependency path="/incomeGapExists"/>
    </Derived>
  </Fact>
  <Fact path="/generalWorkRequirementProbe">
    <Derived>
      <Dependency path="/hasUnemployedWorkEligible"/>
    </Derived>
  </Fact>
  <Fact path="/abawdProbe">
    <Derived>
      <Dependency path="/hasUnemployedAbawdCandidate"/>
    </Derived>
  </Fact>
  <Fact path="/studentEligibilityProbe">
    <Derived>
      <Dependency path="/hasStudentMembers"/>
    </Derived>
  </Fact>
  <Fact path="/immigrationStatusProbe">
    <Derived>
      <Dependency path="/hasNonCitizenMembers"/>
    </Derived>
  </Fact>
  <Fact path="/felonComplianceProbe">
    <Derived>
      <Dependency path="/hasFelonMembers"/>
    </Derived>
  </Fact>
  <Fact path="/changeVerificationProbe">
    <Derived>
      <Dependency path="/application_hasChangedCircumstances"/>
    </Derived>
  </Fact>
</FactDictionaryModule>
