{
  "name": "@codeforamerica/safety-net-blueprint-explorer",
  "version": "1.2.0",
  "description": "Context map and service blueprint tooling for the Safety Net Blueprint",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:context-map": "node build.js --only=context-map",
    "build:data-dictionaries": "node build.js --only=data-dictionaries",
    "build:state-machine-docs": "node build.js --only=state-machine-docs",
    "build:adoption-model": "node build.js --only=adoption-model",
    "build:action-flow": "node diagrams/sequence-diagrams/src/render-action-flow.js diagrams/sequence-diagrams",
    "field-inventory:generate": "node tools/data-dictionaries/generate-field-inventory.mjs",
    "serve": "npx serve . -l 4000",
    "test": "node --test tools/data-dictionaries/tests/"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  },
  "optionalDependencies": {
    "puppeteer": "^22.0.0"
  }
}
