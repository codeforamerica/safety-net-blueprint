{
  "type": "object",
  "required": [
    "id",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "status": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "caseworker",
        "administrative"
      ],
      "description": "Category of notice"
    },
    "reviewer": {
      "type": "string",
      "nullable": true
    },
    "message": {
      "type": "string"
    },
    "caseWorkerId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Notice"
}