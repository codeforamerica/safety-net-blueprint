    "./json-schema": "./src/json-schema/index.js"
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "license": "SEE LICENSE IN LICENSE",
