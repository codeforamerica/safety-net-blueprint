{
  "name": "@codeforamerica/blueprint-core",
  "version": "0.1.1",
  "description": "Blueprint framework core — contract resolution and validation",
  "type": "module",
  "files": [
    "src/",
    "schemas/",
    "base-contracts/",
    "assets/",
    "types.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/index.js"
    },
    "./annotations": "./src/annotations.js",
    "./registries": "./src/registries.js",
    "./rules": "./src/rules.js",
    "./relationships": "./src/relationships.js",
    "./compositions": "./src/compositions.js",
    "./state-machines": "./src/state-machines.js",
    "./overlay": "./src/overlay.js",
    "./openapi": "./src/openapi/index.js",
