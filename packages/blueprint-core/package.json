{
  "name": "@codeforamerica/blueprint-core",
  "version": "0.4.0",
  "description": "Blueprint framework core — contract resolution and validation",
  "type": "module",
  "files": [
    "src/",
    "schemas/",
    "base-contracts/",
    "assets/",
    "types.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./types.d.ts",
      "default": "./src/browser.js"
    },
    "./cel": {
      "default": "./src/cel.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforamerica/safety-net-blueprint.git",
    "directory": "packages/blueprint-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@bufbuild/cel": "^0.6.1",
    "@bufbuild/protobuf": "^2.15.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  }
}
