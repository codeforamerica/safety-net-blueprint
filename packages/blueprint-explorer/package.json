{
  "name": "@codeforamerica/blueprint-explorer",
  "version": "0.1.0",
  "description": "Static documentation generator for Blueprint framework projects — contract reference, state machine diagrams, event catalog, and data dictionaries",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "build.js",
    "schemas/",
    "authored/"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforamerica/safety-net-blueprint.git",
    "directory": "packages/blueprint-explorer"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@codeforamerica/blueprint-core": "^0.1.0",
    "@codeforamerica/blueprint-rules-engine": "^0.1.0",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  }
}
