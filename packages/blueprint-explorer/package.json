{
  "name": "@codeforamerica/blueprint-explorer",
  "version": "0.1.0",
  "description": "Static documentation generator for Blueprint framework projects — contract reference, state machine diagrams, event catalog, and data dictionaries",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:api-reference": "node build.js --only=api-reference",
    "build:client-reference": "node build.js --only=client-reference",
    "build:context-map": "node build.js --only=context-map",
    "build:data-dictionaries": "node build.js --only=data-dictionaries",
    "build:event-catalog": "node build.js --only=event-catalog",
    "build:sequence-diagrams": "node build.js --only=sequence-diagrams",
    "build:rules-docs": "node build.js --only=rules-docs",
    "build:state-machine-docs": "node build.js --only=state-machine-docs",
    "build:field-inventory": "node src/data-dictionaries/generate-field-inventory.mjs",
    "test": "node --test tests/context-map/*.test.js tests/data-dictionaries/*.test.js tests/lib/*.test.js tests/rules-docs/*.test.js",
    "test:unit": "node --test tests/context-map/*.test.js tests/data-dictionaries/*.test.js tests/lib/*.test.js tests/rules-docs/*.test.js",
    "test:goldens-regenerate": "node src/rules-docs/build.js --content=tests/rules-docs/fixtures/content --resolved=tests/rules-docs/fixtures/contracts"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforamerica/safety-net-blueprint.git",
    "directory": "packages/blueprint-explorer"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@codeforamerica/blueprint-core": "^0.1.0",
    "@codeforamerica/blueprint-rules-engine": "^0.1.0",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0"
  }
}
