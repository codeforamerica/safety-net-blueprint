{
  "description": "A benefit application record, including server-managed fields.",
  "unevaluatedProperties": false,
  "required": [
    "id",
    "status",
    "programsApplied",
    "referenceId",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "type": "object",
      "properties": {
        "programsApplied": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "snap",
              "medicaid",
              "chip",
              "tanf"
            ]
          },
          "description": "Benefit programs the household is applying for."
        },
        "channel": {
          "type": "string",
          "enum": [
            "online",
            "phone",
            "in_person",
            "mail"
          ],
          "description": "Channel through which the application was submitted."
        },
        "address": {
          "type": "object",
          "description": "Mailing or residential address.",
          "required": [
            "street",
            "city",
            "state",
            "zip"
          ],
          "properties": {
            "street": {
              "type": "string",
              "description": "Street address including apartment or unit number."
            },
            "city": {
              "type": "string",
              "description": "City name."
            },
            "state": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2,
              "description": "Two-letter US state abbreviation."
            },
            "zip": {
              "type": "string",
              "pattern": "^\\d{5}(-\\d{4})?$",
              "description": "ZIP code or ZIP+4."
            }
          }
        },
        "contactInfo": {
          "type": "object",
          "description": "Contact details for the primary applicant.",
          "properties": {
            "phone": {
              "type": "string",
              "description": "Primary phone number."
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address."
            },
            "preferredContact": {
              "type": "string",
              "enum": [
                "phone",
                "email",
                "mail"
              ],
              "description": "Applicant's preferred method of contact."
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Arbitrary key-value labels for state-specific tagging, routing, and reporting. States may use these to attach jurisdiction-specific metadata without modifying the core schema.\n"
        },
        "countyCode": {
          "type": "string",
          "maxLength": 10,
          "description": "County code for routing this application to the correct local office."
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "readOnly": true,
          "description": "Unique identifier (server-generated)."
        },
        "referenceId": {
          "type": "string",
          "readOnly": true,
          "description": "Short human-readable reference code for this application."
        },
        "confirmationNumber": {
          "type": "string",
          "readOnly": true,
          "description": "Deprecated — use referenceId instead. Legacy confirmation number assigned by older case management systems. Retained for backward compatibility during state migration periods.\n"
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "description": "Current lifecycle status of the application.",
          "enum": [
            "draft",
            "submitted",
            "under_review",
            "withdrawn",
            "closed"
          ]
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true,
          "readOnly": true,
          "description": "Timestamp when the application was formally submitted. Null until submitted."
        },
        "openedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true,
          "readOnly": true,
          "description": "Timestamp when a caseworker began active review. Null until the application is opened."
        },
        "slaTypeCode": {
          "type": "string",
          "readOnly": true,
          "description": "SLA type governing the processing deadline for this application.",
          "enum": [
            "snap_standard",
            "medicaid_standard"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "description": "A household member on a benefit application.",
            "unevaluatedProperties": false,
            "required": [
              "id",
              "applicationId",
              "firstName",
              "lastName",
              "relationship",
              "createdAt",
              "updatedAt"
            ],
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "description": "Member's first name."
                  },
                  "lastName": {
                    "type": "string",
                    "description": "Member's last name."
                  },
                  "dateOfBirth": {
                    "type": "string",
                    "format": "date",
                    "description": "Member's date of birth (YYYY-MM-DD)."
                  },
                  "relationship": {
                    "type": "string",
                    "enum": [
                      "self",
                      "spouse",
                      "child",
                      "parent",
                      "sibling",
                      "other"
                    ],
                    "description": "Relationship of this member to the primary applicant."
                  },
                  "incomeSource": {
                    "description": "Income reported by a household member. Type discriminator determines the variant.",
                    "oneOf": [
                      {
                        "type": "object",
                        "description": "Income from wages or salary employment.",
                        "required": [
                          "type",
                          "employer",
                          "monthlyGrossIncome"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "employment"
                          },
                          "employer": {
                            "type": "string",
                            "description": "Name of the employer."
                          },
                          "monthlyGrossIncome": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Monthly gross income before deductions (dollars)."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "description": "Income from self-employment or a sole proprietorship.",
                        "required": [
                          "type",
                          "businessType",
                          "monthlyNetIncome"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "self_employment"
                          },
                          "businessType": {
                            "type": "string",
                            "description": "Type of business (e.g., sole proprietor, freelance)."
                          },
                          "monthlyNetIncome": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Monthly net income after business expenses (dollars)."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "description": "Income from a government benefit program.",
                        "required": [
                          "type",
                          "benefitType",
                          "monthlyAmount"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "benefit"
                          },
                          "benefitType": {
                            "type": "string",
                            "enum": [
                              "ssi",
                              "ssdi",
                              "unemployment",
                              "veterans",
                              "other"
                            ],
                            "description": "The benefit program providing income."
                          },
                          "monthlyAmount": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Monthly benefit amount (dollars)."
                          }
                        }
                      }
                    ]
                  },
                  "notificationPreference": {
                    "description": "How this member prefers to receive benefit notices and updates.",
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "channel",
                          "address"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string",
                            "enum": [
                              "email"
                            ]
                          },
                          "address": {
                            "type": "string",
                            "format": "email",
                            "description": "Email address for benefit notices."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "channel",
                          "phone"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string",
                            "enum": [
                              "sms"
                            ]
                          },
                          "phone": {
                            "type": "string",
                            "description": "Phone number for SMS benefit notices (E.164 format)."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "channel",
                          "address"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string",
                            "enum": [
                              "mail"
                            ]
                          },
                          "address": {
                            "type": "object",
                            "description": "Mailing or residential address.",
                            "required": [
                              "street",
                              "city",
                              "state",
                              "zip"
                            ],
                            "properties": {
                              "street": {
                                "type": "string",
                                "description": "Street address including apartment or unit number."
                              },
                              "city": {
                                "type": "string",
                                "description": "City name."
                              },
                              "state": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 2,
                                "description": "Two-letter US state abbreviation."
                              },
                              "zip": {
                                "type": "string",
                                "pattern": "^\\d{5}(-\\d{4})?$",
                                "description": "ZIP code or ZIP+4."
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "verificationEvidence": {
                    "description": "Identity verification evidence for this member. Accepts anyOf: an electronic data match result, a manual caseworker review record, or both.\n",
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "source",
                          "matchCode",
                          "verifiedAt"
                        ],
                        "properties": {
                          "source": {
                            "type": "string",
                            "description": "Data source used for the electronic match (e.g., SSA, IRS-IEVS)."
                          },
                          "matchCode": {
                            "type": "string",
                            "description": "Result code returned by the data source."
                          },
                          "verifiedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Timestamp when the electronic verification was completed."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "verifiedBy",
                          "verifiedAt"
                        ],
                        "properties": {
                          "verifiedBy": {
                            "type": "string",
                            "description": "ID of the caseworker who performed the manual verification."
                          },
                          "verifiedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Timestamp when the manual verification was completed."
                          },
                          "notes": {
                            "type": "string",
                            "description": "Optional caseworker notes on the verification outcome."
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "readOnly": true,
                    "description": "Unique identifier (server-generated)."
                  },
                  "applicationId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The application this member belongs to."
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "readOnly": true,
                    "description": "Timestamp when the member was added."
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "readOnly": true,
                    "description": "Timestamp when the member was last updated."
                  },
                  "links": {
                    "type": "object",
                    "readOnly": true,
                    "description": "Related resource links.",
                    "properties": {
                      "application": {
                        "type": "string",
                        "format": "uri-reference",
                        "description": "Link to the related Application resource."
                      }
                    }
                  }
                }
              }
            ]
          },
          "description": "Household members on this application."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "Timestamp when the application was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "Timestamp when the application was last updated."
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "_links": {
          "type": "object",
          "readOnly": true,
          "description": "Generated composition links.",
          "properties": {
            "applicationSummary": {
              "type": "object",
              "description": "Link to the applicationSummary composition.",
              "properties": {
                "href": {
                  "type": "string",
                  "format": "uri-reference",
                  "readOnly": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Application"
}