{
  "allOf": [
    {
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "format": "uuid",
          "description": "The member who receives it."
        },
        "source": {
          "type": "string",
          "enum": [
            "earned",
            "self_employment",
            "unearned"
          ]
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "The amount received each time it's paid, in dollars."
        },
        "frequency": {
          "type": "string",
          "enum": [
            "weekly",
            "biweekly",
            "semimonthly",
            "monthly",
            "irregular"
          ],
          "description": "How often it's paid."
        },
        "paidInCash": {
          "type": "boolean"
        },
        "amountVaries": {
          "type": "boolean",
          "description": "Whether the amount changes from one payment to the next, as with irregular hours or tips."
        },
        "links": {
          "type": "object",
          "readOnly": true,
          "description": "Related resource links.",
          "properties": {
            "member": {
              "type": "string",
              "format": "uri-reference",
              "description": "Link to the related ApplicationMember resource."
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The id a caller may choose for a record it creates, following JSON:API's client-generated ids. Every create schema references it. Without an id, the server sets one. An id another record already has is refused with 409. Choosing the id lets one request name a record another change in it creates, as a JSON Patch to a composition does.\n",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The new record's id, a UUID (RFC 9562)."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "memberId",
        "source",
        "amount",
        "frequency"
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ApplicationIncomeCreate"
}