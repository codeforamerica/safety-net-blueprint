{
  "allOf": [
    {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "Member's first name."
        },
        "lastName": {
          "type": "string",
          "description": "Member's last name."
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Member's date of birth (YYYY-MM-DD)."
        },
        "relationship": {
          "type": "string",
          "enum": [
            "self",
            "spouse",
            "child",
            "parent",
            "sibling",
            "other"
          ],
          "description": "Relationship of this member to the primary applicant."
        },
        "incomeSource": {
          "description": "Income reported by a household member. Type discriminator determines the variant.",
          "oneOf": [
            {
              "type": "object",
              "description": "Income from wages or salary employment.",
              "required": [
                "type",
                "employer",
                "monthlyGrossIncome"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "employment"
                },
                "employer": {
                  "type": "string",
                  "description": "Name of the employer."
                },
                "monthlyGrossIncome": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Monthly gross income before deductions (dollars)."
                }
              }
            },
            {
              "type": "object",
              "description": "Income from self-employment or a sole proprietorship.",
              "required": [
                "type",
                "businessType",
                "monthlyNetIncome"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "self_employment"
                },
                "businessType": {
                  "type": "string",
                  "description": "Type of business (e.g., sole proprietor, freelance)."
                },
                "monthlyNetIncome": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Monthly net income after business expenses (dollars)."
                }
              }
            },
            {
              "type": "object",
              "description": "Income from a government benefit program.",
              "required": [
                "type",
                "benefitType",
                "monthlyAmount"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "benefit"
                },
                "benefitType": {
                  "type": "string",
                  "enum": [
                    "ssi",
                    "ssdi",
                    "unemployment",
                    "veterans",
                    "other"
                  ],
                  "description": "The benefit program providing income."
                },
                "monthlyAmount": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Monthly benefit amount (dollars)."
                }
              }
            }
          ]
        },
        "notificationPreference": {
          "description": "How this member prefers to receive benefit notices and updates.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "channel",
                "address"
              ],
              "properties": {
                "channel": {
                  "type": "string",
                  "enum": [
                    "email"
                  ]
                },
                "address": {
                  "type": "string",
                  "format": "email",
                  "description": "Email address for benefit notices."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "channel",
                "phone"
              ],
              "properties": {
                "channel": {
                  "type": "string",
                  "enum": [
                    "sms"
                  ]
                },
                "phone": {
                  "type": "string",
                  "description": "Phone number for SMS benefit notices, in E.164 format.",
                  "pattern": "^\\+[1-9][0-9]{1,14}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "channel",
                "address"
              ],
              "properties": {
                "channel": {
                  "type": "string",
                  "enum": [
                    "mail"
                  ]
                },
                "address": {
                  "type": "object",
                  "description": "Mailing or residential address.",
                  "required": [
                    "street",
                    "city",
                    "state",
                    "zip"
                  ],
                  "properties": {
                    "street": {
                      "type": "string",
                      "description": "Street address including apartment or unit number."
                    },
                    "city": {
                      "type": "string",
                      "description": "City name."
                    },
                    "state": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 2,
                      "description": "Two-letter US state abbreviation."
                    },
                    "zip": {
                      "type": "string",
                      "pattern": "^\\d{5}(-\\d{4})?$",
                      "description": "ZIP code or ZIP+4."
                    }
                  }
                }
              }
            }
          ]
        },
        "verificationEvidence": {
          "description": "Identity verification evidence for this member. Accepts anyOf: an electronic data match result, a manual caseworker review record, or both.\n",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "source",
                "matchCode",
                "verifiedAt"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Data source used for the electronic match (e.g., SSA, IRS-IEVS)."
                },
                "matchCode": {
                  "type": "string",
                  "description": "Result code returned by the data source."
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when the electronic verification was completed."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "verifiedBy",
                "verifiedAt"
              ],
              "properties": {
                "verifiedBy": {
                  "type": "string",
                  "description": "ID of the caseworker who performed the manual verification."
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when the manual verification was completed."
                },
                "notes": {
                  "type": "string",
                  "description": "Optional caseworker notes on the verification outcome."
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "description": "The id a caller may choose for a record it creates, following JSON:API's client-generated ids. Every create schema references it. Without an id, the server sets one. An id another record already has is refused with 409. Choosing the id lets one request name a record another change in it creates, as a JSON Patch to a composition does.\n",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The new record's id, a UUID (RFC 9562)."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "relationship"
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ApplicationMemberCreate"
}