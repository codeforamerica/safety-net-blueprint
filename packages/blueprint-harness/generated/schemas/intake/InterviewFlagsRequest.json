              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The member's key within the household."
              },
              "dateOfBirth": {
                "type": "string",
                "format": "date"
              },
              "isDisabled": {
                "type": "boolean",
                "description": "Whether the member is disabled."
              }
            }
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "memberId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The job's key within the household."
              },
              "memberId": {
                "type": "string",
                "description": "The member who holds the job."
              },
              "employer": {
                "type": "string"
              }
            }
          }
        },
        "incomes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "memberId",
              "source",
              "amount",
              "frequency"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "The income's key within the household."
              },
              "memberId": {
                "type": "string",
                "description": "The member who receives it."
              },
              "jobId": {
                "type": "string",
                "description": "The job it's paid for, when it's earned."
              },
              "source": {
                "type": "string",
                "enum": [
                  "earned",
                  "self_employment",
                  "unearned"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "The amount received each time it's paid, in dollars."
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "weekly",
                  "biweekly",
                  "semimonthly",
