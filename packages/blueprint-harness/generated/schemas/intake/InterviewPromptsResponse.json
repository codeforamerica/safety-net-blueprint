{
  "allOf": [
    {
      "type": "object",
      "description": "Map of output fact names to their evaluation result. Only output facts are included; intermediate facts are not returned.\n",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "state",
              "value"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "complete"
                ]
              },
              "value": {
                "description": "The computed value."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "state",
              "value"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "placeholder"
                ]
              },
              "value": {
                "description": "The computed value, derived using one or more schema defaults."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "state",
              "value",
              "missing"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "missing"
                ]
              },
              "value": {
                "type": "null"
              },
              "missing": {
                "type": "array",
                "description": "Input paths required to resolve this fact.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "state",
              "value",
              "message"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "error"
                ]
              },
              "value": {
                "type": "null"
              },
              "message": {
                "type": "string",
                "description": "The reason evaluation failed."
              }
            }
          }
        ]
      }
    }
  ],
  "description": "Evaluation result for interviewPrompts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/InterviewPromptsResponse"
}