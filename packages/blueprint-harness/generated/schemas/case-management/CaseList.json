{
  "type": "object",
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A household's ongoing case.",
        "required": [
          "id",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "currentDeterminationId": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "The determination that currently certifies the household. A renewal compares against what it certified, however many recertifications came before.\n"
          },
          "certificationEndDate": {
            "type": "string",
            "format": "date",
            "description": "When the current certification ends."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "links": {
            "type": "object",
            "readOnly": true,
            "description": "Related resource links.",
            "properties": {
              "currentDetermination": {
                "type": "string",
                "format": "uri-reference",
                "description": "Link to the related Determination resource."
              }
            }
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "hasNext": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CaseList"
}