{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "description": "A transcript, including server-managed fields.",
        "unevaluatedProperties": false,
        "required": [
          "id",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "allOf": [
          {
            "type": "object",
            "description": "Client-writable fields of a transcript.",
            "properties": {
              "subjectType": {
                "type": "string",
                "description": "What kind of thing the transcript records, e.g. `interview` or `call`."
              },
              "subjectId": {
                "type": "string",
                "format": "uuid",
                "description": "The record of the conversation it transcribes — an interview's id, say. `subjectType` says what kind."
              },
              "model": {
                "type": "string",
                "description": "The transcription service's identifier for the model that produced\nits lines — e.g. `scribe_v2`. Services change the model behind the\nsame name, so this is what tells two transcripts made a month apart\napart. Where a service does not report a version, the model the\nclient requested — e.g. `standard`. Required unless the profile's\nservice is `none`.\n"
              },
              "client": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*/[0-9A-Za-z.+-]+$",
                "description": "The software that wrote its lines, as `name/version` — a transcription client, or a chat."
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "readOnly": true,
                "description": "Unique identifier (server-generated)."
              },
              "status": {
                "type": "string",
                "readOnly": true,
                "description": "`recording` while the conversation is on the record, `paused`\nwhile it is off it, and `closed` once it has ended.\n",
                "enum": [
                  "recording",
                  "paused",
                  "closed"
                ]
              },
              "startedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true,
                "description": "When the conversation began, by the client's clock — the clock every time on its entries is on."
              },
              "closedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true,
                "description": "When the transcript was closed, by the client's clock."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true,
                "description": "When the transcript was started."
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true,
                "description": "When the transcript last changed."
              },
              "profile": {
                "description": "A profile, including server-managed fields.",
                "unevaluatedProperties": false,
                "required": [
                  "id",
                  "name",
                  "provider",
                  "source",
                  "createdAt",
                  "updatedAt"
                ],
                "allOf": [
                  {
                    "type": "object",
                    "description": "Client-writable fields of a profile.",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                        "description": "A short handle people tell profiles apart by, e.g. `english-phone`. Nothing checks that it is unique."
                      },
                      "description": {
                        "type": "string",
                        "description": "What the profile is for."
                      },
                      "provider": {
                        "type": "string",
                        "description": "The transcription service — an entry of the `transcription-services`\nregistry, which a contract set extends with a registry file of its\nown. `none` for conversations no service transcribes: a chat, or\nlines a person types.\n",
                        "enum": [
                          "aws-transcribe",
                          "elevenlabs-scribe",
                          "none"
                        ]
                      },
                      "languages": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "description": "Preferred language (BCP 47 language tag).",
                          "pattern": "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$"
                        },
                        "description": "The languages the conversation may be in. One fixes the language;\nseveral let the service tell which is being spoken among them.\nAbsent, the service detects the language itself — which not every\nservice can do.\n"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true,
                        "description": "Unique identifier — given in the config for a seeded profile, server-generated for one added here."
                      },
                      "source": {
                        "type": "string",
                        "readOnly": true,
                        "description": "Where a record of a config-seeded resource came from. `system`: the deployment's config file, which seeds it once; afterwards it can be changed through the API, but not deleted. `user`: added through the API, and deletable where the API allows it. A client can use it to leave out a delete it would be refused, without trying it first.\n",
                        "enum": [
                          "system",
                          "user"
                        ]
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "description": "When the profile was added."
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "description": "When the profile last changed."
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of transcripts available."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum number of transcripts requested."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of items skipped before the current page."
    },
    "hasNext": {
      "type": "boolean",
      "description": "Whether more transcripts are available beyond this page."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/TranscriptList"
}