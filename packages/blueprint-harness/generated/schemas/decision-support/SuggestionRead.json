{
  "type": "object",
  "required": [
    "id",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true,
      "description": "Unique identifier (server-generated)."
    },
    "status": {
      "type": "string",
      "readOnly": true,
      "description": "`proposed` while it waits for a decision; `accepted` once a person\nsaid yes and, for an operation, the call was made; `refused` when\na person said yes and the call failed; `dismissed` when a person\nsaid no; `expired` once it stopped applying.\n",
      "enum": [
        "proposed",
        "accepted",
        "refused",
        "dismissed",
        "expired"
      ]
    },
    "fingerprint": {
      "type": "string",
      "readOnly": true,
      "description": "What identifies it, for refusing the same one proposed again. A keyed hash, so nothing can be read back from it."
    },
    "reason": {
      "type": "string",
      "readOnly": true,
      "description": "Why it was dismissed."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "description": "When it was proposed."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "description": "When it last changed."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SuggestionRead"
}