{
  "type": "object",
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applicationId",
          "status",
          "expedited",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "Unique identifier (server-generated)."
          },
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "description": "The intake application this determination is for."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "complete"
            ],
            "readOnly": true,
            "description": "Current status of the eligibility determination."
          },
          "expedited": {
            "type": "boolean",
            "readOnly": true,
            "description": "Whether this household qualifies for expedited processing (7 CFR § 273.2(i))."
          },
          "determinedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "readOnly": true,
            "description": "Timestamp when the determination was finalized. Null until complete."
          },
          "certifiedHousehold": {
            "readOnly": true,
            "description": "The household as this determination certified it: what a renewal compares the household's answers against at the next interview.\n",
            "type": "object",
            "properties": {
              "statedSize": {
                "type": "integer",
                "minimum": 1,
                "description": "The number of people the household says buy and prepare food together."
              },
              "utilitiesIncludedInRent": {
                "type": "boolean",
                "description": "Whether the household says its utilities are included in the rent."
              },
              "statedMonthlyIncome": {
                "type": "number",
                "minimum": 0,
                "description": "Total monthly income, as the household states it."
              },
              "statedMonthlyExpenses": {
                "type": "number",
                "minimum": 0,
                "description": "Total monthly expenses, as the household states them."
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The member's key within the household."
                    },
                    "dateOfBirth": {
                      "type": "string",
                      "format": "date"
                    },
                    "isDisabled": {
                      "type": "boolean",
                      "description": "Whether the member is disabled."
                    }
                  }
                }
              },
              "jobs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "memberId"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The job's key within the household."
                    },
                    "memberId": {
                      "type": "string",
                      "description": "The member who holds the job."
                    },
                    "employer": {
                      "type": "string"
                    }
                  }
                }
              },
              "incomes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "memberId",
                    "source",
                    "amount",
                    "frequency"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The income's key within the household."
                    },
                    "memberId": {
                      "type": "string",
                      "description": "The member who receives it."
                    },
                    "jobId": {
                      "type": "string",
                      "description": "The job it's paid for, when it's earned."
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "earned",
                        "self_employment",
                        "unearned"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0,
                      "description": "The amount received each time it's paid, in dollars."
                    },
                    "frequency": {
                      "type": "string",
                      "enum": [
                        "weekly",
                        "biweekly",
                        "semimonthly",
                        "monthly",
                        "irregular"
                      ],
                      "description": "How often it's paid."
                    },
                    "paidInCash": {
                      "type": "boolean"
                    },
                    "amountVaries": {
                      "type": "boolean",
                      "description": "Whether the amount changes from one payment to the next, as with irregular hours or tips."
                    }
                  }
                }
              },
              "expenses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "amount",
                    "frequency"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "rent",
                        "mortgage",
                        "utilities",
                        "dependent_care",
                        "medical",
                        "child_support"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "frequency": {
                      "type": "string",
                      "enum": [
                        "weekly",
                        "biweekly",
                        "semimonthly",
                        "monthly"
                      ]
                    }
                  }
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Timestamp when the determination was created."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Timestamp when the determination was last updated."
          },
          "links": {
            "type": "object",
            "readOnly": true,
            "description": "Related resource links.",
            "properties": {
              "application": {
                "type": "string",
                "format": "uri-reference",
                "description": "Link to the related Application resource."
              }
            }
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "hasNext": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DeterminationList"
}