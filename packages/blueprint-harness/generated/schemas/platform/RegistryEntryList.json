{
  "description": "Paginated list of registry entries.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "total",
        "limit",
        "offset"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of items available."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of items requested."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items skipped before the current page."
        },
        "hasNext": {
          "type": "boolean",
          "description": "Whether more items are available beyond the current page."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": true,
            "description": "An entry, with its id and the fields its type defines.",
            "properties": {
              "id": {
                "type": "string",
                "description": "The entry's stable id."
              },
              "description": {
                "type": "string",
                "description": "Human-readable text for the entry."
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RegistryEntryList"
}