{
  "description": "A transcript, including server-managed fields.",
  "unevaluatedProperties": false,
  "required": [
    "id",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "type": "object",
      "description": "Client-writable fields of a transcript.",
      "properties": {
        "subjectType": {
          "type": "string",
          "description": "What kind of thing the transcript records, e.g. `interview` or `call`."
        },
        "subjectId": {
          "type": "string",
          "format": "uuid",
          "description": "The record of the conversation it transcribes — an interview's id, say. `subjectType` says what kind."
        },
        "provider": {
          "type": "string",
          "description": "The transcription provider that produced its lines, e.g. `aws-transcribe`."
        },
        "client": {
          "type": "string",
          "description": "The client that wrote to it, and its version."
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "readOnly": true,
          "description": "Unique identifier (server-generated)."
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "description": "`recording` while the conversation is on the record, `paused`\nwhile it is off it, and `closed` once it has ended.\n",
          "enum": [
            "recording",
            "paused",
            "closed"
          ]
        },
        "closedAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "When the transcript was closed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "When the transcript was started."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true,
          "description": "When the transcript last changed."
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Transcript"
}