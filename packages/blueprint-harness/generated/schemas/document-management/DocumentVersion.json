{
  "type": "object",
  "required": [
    "id",
    "documentId",
    "versionNumber",
    "fileName",
    "mimeType",
    "sizeBytes",
    "contentHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "documentId": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "versionNumber": {
      "type": "integer",
      "readOnly": true,
      "description": "Which upload this was, counting from one."
    },
    "fileName": {
      "type": "string",
      "readOnly": true,
      "description": "The name the file was uploaded under."
    },
    "mimeType": {
      "type": "string",
      "readOnly": true
    },
    "sizeBytes": {
      "type": "integer",
      "readOnly": true,
      "description": "How many bytes were received, before they were discarded."
    },
    "contentHash": {
      "type": "string",
      "readOnly": true,
      "description": "SHA-256 of the bytes, computed while reading them."
    },
    "uploadedById": {
      "type": "string",
      "readOnly": true,
      "description": "Whoever sent it, from the caller identity on the request."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "links": {
      "type": "object",
      "readOnly": true,
      "description": "Related resource links.",
      "properties": {
        "document": {
          "type": "string",
          "format": "uri-reference",
          "description": "Link to the related Document resource."
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DocumentVersion"
}