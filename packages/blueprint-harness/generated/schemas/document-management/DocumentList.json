{
  "type": "object",
  "required": [
    "items",
    "total"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "documentTypeId": {
                "type": "string",
                "description": "What kind of document this is."
              },
              "title": {
                "type": "string",
                "description": "A human-readable name for the document."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "fileName",
              "mimeType",
              "sizeBytes",
              "contentHash"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "readOnly": true
              },
              "fileName": {
                "type": "string",
                "readOnly": true,
                "description": "The name the file was uploaded under."
              },
              "mimeType": {
                "type": "string",
                "readOnly": true
              },
              "sizeBytes": {
                "type": "integer",
                "readOnly": true,
                "description": "How many bytes were received, before they were discarded."
              },
              "contentHash": {
                "type": "string",
                "readOnly": true,
                "description": "SHA-256 of the bytes, computed while reading them."
              },
              "uploadedAt": {
                "type": "string",
                "format": "date-time",
                "readOnly": true
              }
            }
          }
        ]
      }
    },
    "total": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "hasNext": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DocumentList"
}