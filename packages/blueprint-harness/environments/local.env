# Values this contract set's ${VAR} placeholders resolve to locally.
#
# The file is also the allowlist: resolve substitutes a variable only if it is
# declared here, so a contract cannot pick up an unrelated machine value. The
# environment may override any of these.

# No jurisdiction prefix on event types.
#
# A deployment sharing a message bus prefixes its events so two deployments'
# cannot be confused — see production.env. Locally there is no bus and nothing
# to disambiguate, and an unprefixed set is what the demo and the tests want:
# publisher and subscriber agree without anything having to strip a prefix
# back off.
EVENT_PREFIX=
