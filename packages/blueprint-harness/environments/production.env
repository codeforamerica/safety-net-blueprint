# What a real deployment would supply. Nothing here runs against it — it exists
# so the difference between environments is one readable line rather than a
# paragraph of documentation.

# Jurisdiction prefix, so this deployment's events are distinguishable from
# another's on a shared bus. `ca.` is illustrative.
EVENT_PREFIX=ca.

# Where a caller signs in (production.overlay.yaml): in the harness, the
# stand-in sign-in page (explorer/pages/fake-sign-in.html), which signs in
# anyone, by any name and role. A state names its identity provider here.
SIGN_IN_URL=pages/fake-sign-in.html
