{
  "name": "@codeforamerica/blueprint-mock-server",
  "version": "0.1.0",
  "description": "Mock API server for blueprint contract development and testing",
  "type": "module",
  "files": [
    "src/",
    "cli/",
    "test-utils.js"
  ],
  "exports": {
    ".": "./cli/server.js",
    "./test-utils": "./test-utils.js"
  },
  "bin": {
    "blueprint-mock": "./cli/server.js",
    "blueprint-swagger": "./cli/swagger/server.js"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-package-readme.js",
    "start": "node cli/server.js --spec=../safety-net-contracts",
    "start:all": "node cli/start-all.js --spec=../safety-net-contracts",
    "swagger": "node cli/swagger/server.js --spec=../safety-net-contracts",
    "seed": "node cli/generate-mock-data.js --spec=../safety-net-contracts --out=../generated/mock-data",
    "validate:mock-data": "node cli/validate-mock-data.js --spec=../safety-net-contracts",
    "setup": "node cli/setup.js --spec=../safety-net-contracts",
    "reset": "node cli/reset.js --spec=../safety-net-contracts",
    "test": "node tests/run-tests.js --all --contracts=../generated/contracts --raw-contracts=../safety-net-contracts --stop",
    "test:unit": "node tests/run-tests.js --unit --fixtures=tests/fixtures --seed=tests/fixtures",
    "test:functional": "node tests/run-tests.js --functional",
    "test:integration": "node tests/run-tests.js --integration --contracts=../generated/contracts --raw-contracts=../safety-net-contracts --stop"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeforamerica/safety-net-blueprint",
    "directory": "packages/blueprint-mock-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@codeforamerica/blueprint-core": "^0.1.0",
    "@faker-js/faker": "^10.4.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "json-logic-js": "^2.0.5",
    "multer": "^2.1.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "axios": "^1.7.0",
    "newman": "^6.2.1",
    "tsx": "^4.23.1",
    "zod": "^4.0.0"
  }
}
