{
  "name": "@codeforamerica/blueprint-mock-server",
  "version": "0.2.0",
  "description": "Mock API server for contract-first development \u2014 auto-generates CRUD, RPC, and event endpoints from Blueprint contracts",
  "type": "module",
  "files": [
    "src/",
    "cli/"
  ],
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser.js",
    "./store": "./src/stores/memory-store.js",
    "./test-utils": "./src/test-utils.js",
    "./routes": "./src/http/route-table.js"
  },
  "bin": {
    "blueprint-mock": "cli/server.js",
    "blueprint-swagger": "cli/swagger/server.js"
  },
  "scripts": {
    "start": "node cli/server.js --spec=../generated/contracts",
    "start:all": "node cli/start-all.js --spec=../generated/contracts",
    "swagger": "node cli/swagger/server.js --spec=../generated/contracts",
    "seed": "node cli/generate-mock-data.js --spec=../generated/contracts --out=../generated/mock-data",
    "validate:mock-data": "node cli/validate-mock-data.js --spec=../generated/contracts",
    "setup": "node cli/setup.js --spec=../generated/contracts",
    "reset": "node cli/reset.js --spec=../generated/contracts",
    "test": "node tests/run-tests.js --all --contracts=../generated/contracts --raw-contracts=../safety-net-contracts/src --stop",
    "test:unit": "node tests/run-tests.js --unit --fixtures=tests/fixtures --seed=tests/fixtures",
    "test:functional": "node tests/run-tests.js --functional",
    "test:integration": "node tests/run-tests.js --integration --contracts=../generated/contracts --raw-contracts=../safety-net-contracts/src --stop"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforamerica/safety-net-blueprint.git",
    "directory": "packages/blueprint-mock-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^11.7.2",
    "@codeforamerica/blueprint-core": "^0.2.0",
    "@codeforamerica/blueprint-rules-engine": "^0.1.0",
    "@faker-js/faker": "^10.4.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.0.0",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "json-logic-js": "^2.0.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "axios": "^1.7.0",
    "esbuild": "^0.28.2",
    "newman": "^6.2.1",
    "tsx": "^4.23.1",
    "zod": "^4.0.0"
  }
}
