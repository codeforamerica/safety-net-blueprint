{
  "name": "@codeforamerica/blueprint-safety-net-contracts",
  "version": "0.1.0",
  "description": "OpenAPI specs, state machines, event schemas, and overlays for safety net benefits programs — reference implementation of the Blueprint framework",
  "type": "module",
  "files": [
    "src/"
  ],
  "scripts": {
    "validate": "node ../blueprint-cli/scripts/validate/openapi.js --spec=. --skip-examples",
    "resolve": "node ../blueprint-cli/scripts/resolve.js --spec=. --out=../generated/contracts",
    "test": "node tests/run-tests.js --all --contracts=../generated/contracts --seed=tests/integration/seed --clients=../generated/clients --stop",
    "test:unit": "node tests/run-tests.js --unit",
    "test:integration": "node tests/run-tests.js --integration --contracts=../generated/contracts --seed=tests/integration/seed --clients=../generated/clients --stop"
  },
  "dependencies": {
    "@codeforamerica/blueprint-mock-server": "^0.1.0"
  },
  "devDependencies": {
    "@codeforamerica/blueprint-cli": "^0.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeforamerica/safety-net-blueprint.git",
    "directory": "packages/safety-net-contracts"
  },
  "publishConfig": {
    "access": "public"
  }
}
