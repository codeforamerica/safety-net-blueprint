  <languageCode>en_US</languageCode>
  <ruleset vocabularyUpdateStamp="_ap0000000000000000" vocabulary="vocab.ecore#/">
    <ruleStatement post="Info" ruleModelElements="#//@ruleset/@rules.0">
      <text expression="Sets reviewTrack to the activity type of the chronologically first work activity — exercises sortedBy/first collection navigation">
        <parserOutput xsi:type="com.corticon.rulesemf.asg:Expression" text="Sets reviewTrack to the activity type of the chronologically first work activity — exercises sortedBy/first collection navigation" expressiontype="BRSTATEMENT">
