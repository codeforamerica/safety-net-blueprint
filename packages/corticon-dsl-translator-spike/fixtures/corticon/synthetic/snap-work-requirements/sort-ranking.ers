        </parserOutput>
      </text>
    </ruleStatement>

    <rule documentingRuleStatements="0"/>
    <rule>
      <action>
        <opaqueExpression expression="ApplicationMember.reviewTrack = activity->sortedBy(activityDate)->first.activityType">
          <parserOutput xsi:type="com.corticon.rulesemf.asg:Expression" text="ApplicationMember.reviewTrack = activity->sortedBy ( activity.activityDate )->first.activityType" datatype="String" expressiontype="ASSIGNMENT" enumeration="false" cellValue="false">
            <modifiedTermList>
              <terms text="reviewTrack" datatype="String" termtype="ATTRIBUTE" fulltext="ApplicationMember.reviewTrack">
                <parentTerm text="ApplicationMember" datatype="ApplicationMember" termtype="ENTITY" fulltext="ApplicationMember" variable="#//@ruleset/@logicalVariables.0"/>
              </terms>
