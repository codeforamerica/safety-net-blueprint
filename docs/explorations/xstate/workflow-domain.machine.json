{
  "id": "workflow",
  "description": "Workflow's subscriptions that create or find tasks rather than act on one.",
  "initial": "listening",
  "states": {
    "listening": {
      "on": {
        "eligibility.application.expedited": {
          "actions": [
            {
              "type": "if",
              "params": {
                "condition": "$task.id != null",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "PATCH",
                      "path": "workflow/tasks/$task.id",
                      "body": {
                        "isExpedited": true,
                        "slaType": "snap_expedited"
                      }
                    }
                  }
                ]
              }
            }
          ],
          "description": "Flag the intake review task as expedited and switch it to the 7-day SLA when SNAP expedited criteria are confirmed (7 CFR § 273.2(i))",
          "meta": {
            "context": [
              {
                "task": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "application_review"
                  }
                }
              }
            ]
          }
        },
        "intake.application.submitted": {
          "actions": [
            {
              "type": "request",
              "params": {
                "method": "POST",
                "path": "workflow/tasks",
                "body": {
                  "taskType": "application_review",
                  "name": "Application review",
                  "status": "pending",
                  "subjectType": "application",
                  "subjectId": "$this.subject"
                },
                "description": "Create an intake review task when an application is submitted"
              }
            }
          ],
          "description": "Create an application review task when a new application is submitted"
        },
        "intake.application.closed": {
          "actions": [
            {
              "type": "if",
              "params": {
                "condition": "$reviewTask.id != null && $reviewTask.status == \"pending_review\"",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$reviewTask.id/approve",
                      "body": {
                        "outcome": "application_closed"
                      },
                      "description": "Complete the caseworker task that was awaiting supervisor approval"
                    }
                  }
                ]
              }
            },
            {
              "type": "if",
              "params": {
                "condition": "$reviewTask.id != null && $reviewTask.status == \"in_progress\"",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$reviewTask.id/complete",
                      "body": {
                        "outcome": "application_closed"
                      },
                      "description": "Complete the active caseworker task on application close"
                    }
                  }
                ]
              }
            },
            {
              "type": "if",
              "params": {
                "condition": "$reviewTask.id != null && $reviewTask.status == \"pending\"",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$reviewTask.id/cancel",
                      "body": {
                        "reason": "application_closed"
                      },
                      "description": "Cancel the unclaimed caseworker task when the application was auto-determined at submission"
                    }
                  }
                ]
              }
            },
            {
              "type": "if",
              "params": {
                "condition": "$approvalTask.id != null",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$approvalTask.id/complete",
                      "body": {
                        "outcome": "application_closed"
                      },
                      "description": "Complete the supervisor approval task"
                    }
                  }
                ]
              }
            }
          ],
          "description": "Complete open tasks for the application when intake closes; handles direct close, supervisor-approved close, and auto-determination paths",
          "meta": {
            "context": [
              {
                "reviewTask": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "application_review"
                  }
                }
              },
              {
                "approvalTask": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "determination_approval"
                  }
                }
              }
            ]
          }
        },
        "intake.determination.approval_needed": {
          "actions": [
            {
              "type": "if",
              "params": {
                "condition": "$reviewTask.id != null",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$reviewTask.id/submit-for-review",
                      "description": "Move caseworker task to pending_review while supervisor reviews the determination"
                    }
                  }
                ]
              }
            },
            {
              "type": "request",
              "params": {
                "method": "POST",
                "path": "workflow/tasks",
                "body": {
                  "taskType": "determination_approval",
                  "name": "Determination approval",
                  "status": "pending",
                  "subjectType": "application",
                  "subjectId": "$this.subject"
                },
                "description": "Create a supervisor approval task"
              }
            }
          ],
          "description": "Move the caseworker's review task to pending_review and create a supervisor approval task when a determination requires sign-off",
          "meta": {
            "context": [
              {
                "reviewTask": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "application_review"
                  }
                }
              }
            ]
          }
        },
        "intake.determination.rejected": {
          "actions": [
            {
              "type": "if",
              "params": {
                "condition": "$reviewTask.id != null",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$reviewTask.id/return-to-worker",
                      "body": {
                        "reason": "determination_rejected"
                      },
                      "description": "Return the caseworker task to in_progress for revision"
                    }
                  }
                ]
              }
            },
            {
              "type": "if",
              "params": {
                "condition": "$approvalTask.id != null",
                "then": [
                  {
                    "type": "request",
                    "params": {
                      "method": "POST",
                      "path": "workflow/tasks/$approvalTask.id/complete",
                      "body": {
                        "outcome": "determination_rejected"
                      },
                      "description": "Complete the supervisor approval task with a rejected outcome"
                    }
                  }
                ]
              }
            }
          ],
          "description": "Return the caseworker's review task to in_progress and complete the supervisor approval task when a determination is rejected",
          "meta": {
            "context": [
              {
                "reviewTask": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "application_review"
                  }
                }
              },
              {
                "approvalTask": {
                  "from": "workflow/tasks",
                  "where": {
                    "subjectId": "$this.subject",
                    "taskType": "determination_approval"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
